<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <timestamp key="inicioEjecucion" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ARCHIVO_ERRORES" class="ch.qos.logback.core.FileAppender">
        <file>logs/ejecucion-${inicioEjecucion}.txt</file>
        <append>true</append>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO_ERRORES"/>
    </root>
</configuration>
