<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="20"
      prefWidth="760"
      prefHeight="700"
      stylesheets="@../Styles/EditarInformacionPacienteStyle.css"
      styleClass="editar-informacion-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.SistemaHistoriasClinicas.Controllers.EditarInformacionPacienteController">

    <padding>
        <Insets top="35" right="45" bottom="35" left="45"/>
    </padding>

    <Label text="Editar información del paciente" styleClass="titulo"/>

    <GridPane hgap="20" vgap="14" styleClass="formulario">

        <columnConstraints>
            <ColumnConstraints minWidth="170" prefWidth="190"/>
            <ColumnConstraints minWidth="280" prefWidth="420" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Medicación:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>

        <TextArea fx:id="medicacionInput"
                  promptText="Ingrese la medicación del paciente"
                  wrapText="true"
                  prefRowCount="6"
                  styleClass="texto-largo-input"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0"/>

        <Label text="Actividad física:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>

        <TextArea fx:id="actividadFisicaInput"
                  promptText="Describa la actividad física del paciente"
                  wrapText="true"
                  prefRowCount="6"
                  styleClass="texto-largo-input"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="1"/>
    </GridPane>

    <Button text="Guardar"
            onAction="#guardarInformacion"
            styleClass="boton-guardar"/>

    <Button text="Volver a la consulta"
            onAction="#volverANuevaConsulta"
            styleClass="boton-volver"/>
</VBox>
