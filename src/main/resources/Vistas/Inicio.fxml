<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" stylesheets="@../Styles/InicioStyle.css" styleClass="inicio-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SistemaHistoriasClinicas.Controllers.InicioController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    <Label text="Gestion de Historias Clinicas" styleClass="titulo"/>
    <Label text="Ingresar un documento para buscar un paciente" styleClass="subtitulo"/>
    <TextField fx:id="documentoInput" promptText="Número de documento" styleClass="documento-input"/>
    <Button text="Buscar" onAction="#buscarPaciente" styleClass="boton-buscar"/>
    <Label text="Para ingresar un nuevo paciente:" styleClass="texto-nuevo-paciente"/>
    <Button text="Nuevo paciente" onAction="#nuevoPaciente" styleClass="boton-nuevo-paciente"/>
</VBox>