<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="20"
      prefWidth="760"
      prefHeight="620"
      stylesheets="@../Styles/InformacionDeConsultaStyle.css"
      styleClass="informacion-consulta-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.SistemaHistoriasClinicas.Controllers.InformacionDeConsultaController">

    <padding>
        <Insets top="35" right="45" bottom="35" left="45"/>
    </padding>

    <Label text="Información de la consulta" styleClass="titulo"/>

    <GridPane hgap="20" vgap="14" styleClass="datos">

        <columnConstraints>
            <ColumnConstraints minWidth="170" prefWidth="190"/>
            <ColumnConstraints minWidth="280" prefWidth="420" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Datos de la consulta:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="datosDeConsultaValor" styleClass="campo-valor-largo"
               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Diagnóstico:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="diagnosticoValor" styleClass="campo-valor-largo"
               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <Button text="Volver"
            onAction="#volver"
            styleClass="boton-volver"/>
</VBox>
