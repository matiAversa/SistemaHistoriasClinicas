<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="20"
      prefWidth="760"
      prefHeight="720"
      stylesheets="@../Styles/NuevoPacienteStyle.css"
      styleClass="nuevo-paciente-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.SistemaHistoriasClinicas.Controllers.NuevoPacienteController">

    <padding>
        <Insets top="35" right="45" bottom="35" left="45"/>
    </padding>

    <Label text="Nuevo paciente" styleClass="titulo"/>

    <GridPane hgap="20" vgap="14" styleClass="formulario">

        <columnConstraints>
            <ColumnConstraints minWidth="170" prefWidth="190"/>
            <ColumnConstraints minWidth="280" prefWidth="420" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nombre:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>

        <TextField fx:id="nombreInput"
                   promptText="Ingrese el nombre"
                   styleClass="campo-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Apellido:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>

        <TextField fx:id="apellidoInput"
                   promptText="Ingrese el apellido"
                   styleClass="campo-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Teléfono:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>

        <TextField fx:id="telefonoInput"
                   promptText="Ingrese el teléfono"
                   styleClass="campo-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Documento:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="3"/>

        <TextField fx:id="documentoInput"
                   promptText="Ingrese el documento"
                   styleClass="campo-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

        <Label text="Número de afiliado:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="4"/>

        <TextField fx:id="numeroAfiliadoInput"
                   promptText="Ingrese el número de afiliado"
                   styleClass="campo-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>

        <Label text="Fecha de nacimiento:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="5"/>

        <HBox spacing="10"
              GridPane.columnIndex="1"
              GridPane.rowIndex="5">

            <TextField fx:id="diaInput"
                       promptText="Día"
                       styleClass="fecha-input"/>

            <TextField fx:id="mesInput"
                       promptText="Mes"
                       styleClass="fecha-input"/>

            <TextField fx:id="anoInput"
                       promptText="Año"
                       styleClass="ano-input"/>
        </HBox>

        <Label text="Edad:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="6"/>

        <TextField fx:id="edadInput"
                   editable="false"
                   focusTraversable="false"
                   promptText="Automática"
                   styleClass="edad-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="6"/>

        <Label text="Medicación:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="7"/>

        <TextArea fx:id="medicacionInput"
                  promptText="Ingrese la medicación del paciente"
                  wrapText="true"
                  prefRowCount="5"
                  styleClass="texto-largo-input"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="7"/>

        <Label text="Actividad física:" styleClass="campo-label"
               GridPane.columnIndex="0" GridPane.rowIndex="8"/>

        <TextArea fx:id="actividadFisicaInput"
                  promptText="Describa la actividad física del paciente"
                  wrapText="true"
                  prefRowCount="5"
                  styleClass="texto-largo-input"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="8"/>
    </GridPane>

    <Button text="Almacenar paciente"
            onAction="#AlmacenarNuevoPaciente"
            styleClass="boton-guardar"/>
    <Button text="Volver al inicio"
            onAction="#volverAlInicio"
            styleClass="boton-volver"/>
</VBox>